# -- required ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=your-bucket

# --- optional ---
S3_REGION=us-east-1
# S3_API_KEY=

# Folder to download when no CLI argument is given, e.g. `cargo run -- 2026/09/03/`
S3_PREFIX=2026/09/03/

# Where files are written (default: data)
DOWNLOAD_DIR=data
# Parallel downloads (default: 8)
DOWNLOAD_CONCURRENCY=8
